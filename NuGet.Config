		<packageSource key="Microsoft Health">
			<package pattern="Microsoft.Health.*" />
		</packageSource>
		<packageSource key="feed-SRACE">
			<package pattern="S_RACE.*" />
			<package pattern="SRace.*" />
			<package pattern="SRACE.*" />
		</packageSource>
	</packageSourceMapping>
